generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id           String        @id
  name         String?
  appointments Appointment[]
}

model Clinician {
  id           String        @id
  name         String?
  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(uuid())
  clinicianId String
  patientId   String
  start       DateTime
  end         DateTime

  clinician Clinician @relation(fields: [clinicianId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])

  @@index([clinicianId, start, end])
  @@index([start])
}